# v4 Hybrid Model Configuration
# Claude Sonnet for complex tasks, DeepSeek Flash for simple tasks

# Primary Claude model (complex reasoning, architecture, debugging)
ANTHROPIC_API_KEY=sk-ant-v7-[your-actual-key]
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek Flash as subagent model (simple tasks, delegated work)
# Uses Anthropic-compatible API endpoint
DEEPSEEK_HYBRID_API_KEY=sk-fef5919abdbd4b36a8752b1cdeb62e3d
DEEPSEEK_HYBRID_MODEL=deepseek-v4-flash
DEEPSEEK_HYBRID_API_URL=https://api.deepseek.com/anthropic

# Enable hybrid mode in Claude Code
CLAUDE_CODE_HYBRID_MODE=true
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash

# Vite/Build variables
VITE_DEEPSEEK_API_KEY=sk-fef5919abdbd4b36a8752b1cdeb62e3d
