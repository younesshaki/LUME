+for chat inference with streaming support. The file should:                                                 
+
+ • Accept a list of messages (with role and content) and an optional AbortSignal.                           
+ • Return an async generator that yields partial content strings as they arrive.                            
+ • Handle errors gracefully (network errors, API errors, etc.).                                             
+ • Use environment variables for the API URL and API key (e.g., VITE_DEEPSEEK_API_URL and                   
+   VITE_DEEPSEEK_API_KEY).                                                                                  
+ • Support streaming via the stream: true parameter in the request body.                                    
+
+We'll also need to update src/vite-env.d.ts to declare the new environment variables.                       
+
+Additionally, we'll need to modify src/components/chat/OllamaChat.state.ts to use the new Deepseek service  
+instead of Ollama. However, the user only asked to create the new file. We'll also need to update the       
+environment variable declarations.                                                                          
+
+Let's propose the changes.                                                                                  
+
+First, create src/lib/deepseekService.ts.                                                                   
+
+Second, update src/vite-env.d.ts to add the new environment variables.                                      
+
+Third, we may need to update src/components/chat/OllamaChat.state.ts to use the new service, but the user   
+didn't explicitly ask for that. However, they said "It should replace the Ollama calls in                   
+OllamaChat.state.ts". So we should also modify that file.                                                   
+
+We'll provide SEARCH/REPLACE blocks for each file.                                                          
+
+Let's craft the code.                                                                                       
+
+src/lib/deepseekService.ts:                                                                                 
+
+                                                                                                            
+/**                                                                                                         
+ * Deepseek API chat inference service with streaming support.                                              
+ * Replaces Ollama calls in the chat state.                                                                 
+ */                                                                                                         
+                                                                                                            
+const DEEPSEEK_API_URL =                                                                                    
+  (import.meta.env.VITE_DEEPSEEK_API_URL as string | undefined) ??                                          
+  "https://api.deepseek.com/v1/chat/completions";                                                           
+                                                                                                            
+const DEEPSEEK_API_KEY =                                                                                    
+  (import.meta.env.VITE_DEEPSEEK_API_KEY as string | undefined) ?? "";                                      
+                                                                                                            
+export type DeepseekMessage = {                                                                             
+  role: "user" | "assistant" | "system";                                                                    
+  content: string;                                                                                          
+};                                                                                                          
+                                                                                                            
+export type DeepseekStreamChunk = {                                                                         
+  choices?: Array<{                                                                                         
+    delta?: {                                                                                               
+      content?: string;                                                                                     
+    };                                                                                                      
+    finish_reason?: string | null;                                                                          
+  }>;                                                                                                       
+  error?: string;                                                                                           
+};                                                                                                          
+                                                                                                            
+/**                                                                                                         
+ * Stream a chat completion from Deepseek.                                                                  
+ * Yields partial content strings as they arrive.                                                           
+ * Throws on network errors or API errors.                                                                  
+ */                                                                                                         
+export async function* streamDeepseekChat(                                                                  
+  messages: DeepseekMessage[],                                                                              
+  signal?: AbortSignal                                                                                      
+): AsyncGenerator<string, void, unknown> {                                                                  
+  const response = await fetch(DEEPSEEK_API_URL, {                                                          
+    method: "POST",                                                                                         
+    headers: {                                                                                              
+      "Content-Type": "application/json",                                                                   
+      Authorization: `Bearer ${DEEPSEEK_API_KEY}`,                                                          
+    },                                                                                                      
+    body: JSON.stringify({                                                                                  
+      model: "deepseek-chat", // or use env variable VITE_DEEPSEEK_MODEL                                    
+      messages,                                                                                             
+      stream: true,                                                                                         
+    }),                                                                                                     
+    signal,                                                                                                 
+  });                                                                                                       
+                                                                                                            
+  if (!response.ok) {                                                                                       
+    let errorBody = "";                                                                                     
+    try {                                                                                                   
+      errorBody = await response.text();                                                                    
+    } catch {                                                                                               
+      // ignore                                                                                             
+    }                                                                                                       
+    throw new Error(                                                                                        
+      `Deepseek API error: ${response.status} ${response.statusText}${                                      
+        errorBody ? ` - ${errorBody}` : ""                                                                  
+      }`                                                                                                    
+    );                                                                                                      
+  }                                                                                                         
+                                                                                                            
+  const reader = response.body?.getReader();                                                                
+  if (!reader) {                                                                                            
+    throw new Error("Deepseek API response body is not readable");                                          
+  }                                                                                                         
+                                                                                                            
+  const decoder = new TextDecoder();                                                                        
+  let buffer = "";                                                                                          
+                                                                                                            
+  try {                                                                                                     
+    while (true) {                                                                                          
+      const { done, value } = await reader.read();                                                          
+      if (done) break;                                                                                      
+                                                                                                            
+      buffer += decoder.decode(value, { stream: true });                                                    
+      const lines = buffer.split("\n");                                                                     
+      // Keep the last incomplete line in the buffer                                                        
+      buffer = lines.pop() ?? "";                                                                           
+                                                                                                            
+      for (const line of lines) {                                                                           
+        const trimmed = line.trim();                                                                        
+        if (!trimmed) continue;                                                                             
+        if (trimmed === "data: [DONE]") {                                                                   
+          // Stream finished                                                                                
+          return;                                                                                           
+        }                                                                                                   
+        if (trimmed.startsWith("data: ")) {                                                                 
+          const jsonStr = trimmed.slice(6);                                                                 
+          try {                                                                                             
+            const chunk: DeepseekStreamChunk = JSON.parse(jsonStr);                                         
+            if (chunk.error) {                                                                              
+              throw new Error(`Deepseek API error: ${chunk.error}`);                                        
+            }                                                                                               
+            const content = chunk.choices?.[0]?.delta?.content;                                             
+            if (content) {                                                                                  
+              yield content;                                                                                
+            }                                                                                               
+          } catch (parseErr) {                                                                              
+            // If JSON parsing fails, skip the line (malformed)                                             
+            console.warn("[deepseek] Failed to parse chunk:", jsonStr, parseErr);                           
+          }                                                                                                 
+        }                                                                                                   
+      }                                                                                                     
+    }                                                                                                       
+  } finally {                                                                                               
+    reader.releaseLock();                                                                                   
+  }                                                                                                         
+}                                                                                                           
+                                                                                                            
+/**                                                                                                         
+ * Non-streaming convenience function.                                                                      
+ * Returns the full response content as a string.                                                           
+ */                                                                                                         
+export async function deepseekChat(                                                                         
+  messages: DeepseekMessage[],                                                                              
+  signal?: AbortSignal                                                                                      
+): Promise<string> {                                                                                        
+  let fullContent = "";                                                                                     
+  for await (const chunk of streamDeepseekChat(messages, signal)) {                                         
+    fullContent += chunk;                                                                                   
+  }                                                                                                         
+  return fullContent;                                                                                       
+}                                                                                                           
