# Public Vite development only. When the server-side subdomain routing flag is
# also enabled, preserve default.lume.local as the Host on proxied API calls.
VITE_SUBDOMAIN_TENANT_ROUTING_ENABLED=false

# Deployment identity. Vercel Production uses production; only the Git staging
# branch may use staging. Local development can leave this as development.
LUME_ENVIRONMENT=development

# Public app + standalone API configuration. Staging must use a different
# Supabase project from production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VISITOR_SESSION_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_R2_PUBLIC_BASE_URL=
VITE_LUME_TENANT=default

# PostHog browser telemetry. The project token is publishable, but keep server
# ingest credentials below server-only. Replay is off unless explicitly enabled
# and always masks all visible text/inputs; raw concierge text never goes there.
VITE_POSTHOG_ENABLED=0
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_SESSION_REPLAY=0

# Public Vercel Function only. /api/leads derives its admin API target from
# LUME_CHAT_UPSTREAM_URL when this override is absent. Keep both values
# server-only; neither is exposed to the Vite browser bundle.
LUME_CHAT_UPSTREAM_URL=
LUME_LEADS_UPSTREAM_URL=

# Enable only after migration 071_public_inventory_slug_fast_path.sql has been
# applied to this environment. The flag keeps a code-first deployment from
# attempting a missing RPC on public inventory requests.
LUME_INVENTORY_SLUG_FAST_PATH=false

# Phase 3 contextual interpretation. Keep disabled unless the exact concierge
# model has passed the versioned held-out evaluation. Active rollout requires
# BOTH the global flag and an exact comma-separated tenant slug allowlist.
CONCIERGE_CONTEXTUAL_INTERPRETER=false
CONCIERGE_CONTEXTUAL_INTERPRETER_TENANTS=

# Shadow evaluation is mutually exclusive with active interpretation for a
# tenant. It records bounded, content-free comparison telemetry and never
# changes the response, state, query, or actions.
CONCIERGE_SHADOW_INTERPRETER=false
CONCIERGE_SHADOW_INTERPRETER_TENANTS=

# Full fidelity concierge traces are only for approved internal test tenants.
# All three gates are mandatory and the tenant list must contain exact UUIDs.
LUME_INTERNAL_TESTING=0
LUME_CONCIERGE_TRACE_MODE=off
LUME_INTERNAL_TRACE_TENANT_IDS=
