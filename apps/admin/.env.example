# Required for the admin app and its API routes.
# Copy to .env.local and fill in your Supabase + Deepseek credentials.

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                        # safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...                # SERVER ONLY — never expose

# Public-facing (browser-readable) variants used by Next.js client components.
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
NEXT_PUBLIC_PUBLIC_SITE_URL=https://public-site.example.com

# ─── Deepseek (used by /api/chat) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Default off. Enable only after tenant consent/privacy review for persistent,
# rule-based preference learning from signed-in visitor chat sessions.
VISITOR_PREFERENCE_LEARNING_ENABLED=false

# ─── Embeddings (optional) ─────────────────────────────────────────────────
# /api/chat uses keyword + fuzzy retrieval by default — no embedder needed.
# When the knowledge base outgrows in-memory scoring, swap retrieveByKeywords()
# for retrieveContext() in app/api/chat/route.ts and configure an embedder
# here (OpenAI text-embedding-3-small, Cloudflare Workers AI, etc.).

# ─── Origin allowlist for /api/chat ────────────────────────────────────────
# Comma-separated origins permitted to call /api/chat. Requests with a
# missing or non-matching Origin header are rejected with 403. Keep tight.
ALLOWED_CHAT_ORIGINS=http://localhost:5173,https://lume.com

# Optional. When configured, /api/leads requires a valid Cloudflare Turnstile
# token in the request body. Keep the secret server-only.
TURNSTILE_SECRET_KEY=

# Server-only bearer token for protected scheduled maintenance routes.
CRON_SECRET=

# Optional. Structured error payloads are always written to stderr (Vercel log
# drains pick them up); set this to also forward each capture to any JSON
# webhook collector (Slack, Axiom, custom). Best-effort, 3s timeout.
ERROR_WEBHOOK_URL=

# Transactional email (server-only). Missing RESEND_API_KEY disables delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare R2 vehicle image uploads (server-only except the public base URL).
R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=lume-vehicle-images
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
