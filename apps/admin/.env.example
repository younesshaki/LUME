# Required for the admin app and its API routes.
# Copy to .env.local and fill in your Supabase + Deepseek credentials.

# Deployment identity. Branch-scoped staging variables must set this to
# staging and must target a separate Supabase project.
LUME_ENVIRONMENT=development

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                        # safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...                # SERVER ONLY — never expose
VISITOR_SESSION_SECRET=                             # SERVER ONLY — staging and production differ

# Public-facing (browser-readable) variants used by Next.js client components.
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
NEXT_PUBLIC_PUBLIC_SITE_URL=https://public-site.example.com

# Default-off subdomain request routing. Enable only after wildcard DNS/TLS is
# provisioned; LUME_ROOT_DOMAIN is a hostname only (for example, lume.app).
SUBDOMAIN_TENANT_ROUTING_ENABLED=false
LUME_ROOT_DOMAIN=lume.app

# ─── Deepseek (used by /api/chat) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ─── Moonshot/Kimi (optional models in Admin > Bot Configuration) ──────────
# Server-only. Never expose this key through NEXT_PUBLIC_* or VITE_* variables.
MOONSHOT_API_KEY=sk-...
MOONSHOT_API_URL=https://api.moonshot.ai/v1/chat/completions

# ─── Vercel AI Gateway (optional GPT/Claude models) ─────────────────────────
# Server-only. Create a scoped AI Gateway key in Vercel and set it only in the
# Admin deployment/environment. GPT and Claude remain unavailable in Admin >
# Concierge until this is configured. Never use NEXT_PUBLIC_* or VITE_* here.
AI_GATEWAY_API_KEY=
AI_GATEWAY_API_URL=https://ai-gateway.vercel.sh/v1/chat/completions

# Default off. Enable only after tenant consent/privacy review for persistent,
# rule-based preference learning from signed-in visitor chat sessions.
VISITOR_PREFERENCE_LEARNING_ENABLED=false

# ─── Embeddings (optional) ─────────────────────────────────────────────────
# /api/chat uses keyword + fuzzy retrieval by default — no embedder needed.
# When the knowledge base outgrows in-memory scoring, swap retrieveByKeywords()
# for retrieveContext() in app/api/chat/route.ts and configure an embedder
# here (OpenAI text-embedding-3-small, Cloudflare Workers AI, etc.).

# ─── Origin allowlist for /api/chat ────────────────────────────────────────
# Comma-separated origins permitted to call /api/chat. Requests with a
# missing or non-matching Origin header are rejected with 403. Keep tight.
ALLOWED_CHAT_ORIGINS=http://localhost:5173,https://lume.com

# Optional. When configured, /api/leads requires a valid Cloudflare Turnstile
# token in the request body. Keep the secret server-only.
TURNSTILE_SECRET_KEY=

# Server-only bearer token for protected scheduled maintenance routes.
CRON_SECRET=

# Optional. Structured error payloads are always written to stderr (Vercel log
# drains pick them up); set this to also forward each capture to any JSON
# webhook collector (Slack, Axiom, custom). Best-effort, 3s timeout.
ERROR_WEBHOOK_URL=

# Optional concierge state/action diagnostics. Use only in local or staging
# while investigating filter continuity; records are emitted to server logs.
LUME_CHAT_DEBUG=0

# Transactional email (server-only). Missing RESEND_API_KEY disables delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Optional custom-domain automation. Both token and project are required;
# missing values preserve database-only domain management without API calls.
VERCEL_ADMIN_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional 24-hour visitor conversation memory. Provision Upstash through the
# Vercel Marketplace; missing values use a per-instance in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Edge Function upload scanning. The webhook secret authenticates
# Storage INSERT events; scanner URL/token are server-only and optional until
# a ClamAV-compatible HTTP bridge is provisioned.
ANTIVIRUS_WEBHOOK_SECRET=
CLAMAV_SCAN_URL=
CLAMAV_SCAN_TOKEN=

# 32 random bytes encoded as base64. Encrypts per-tenant CRM webhook signing
# secrets at rest; required before endpoints can be created or delivered.
WEBHOOK_ENCRYPTION_KEY=

# 32 random bytes encoded as base64. Encrypts managed inventory-source and
# syndication credentials at rest; required only when an integration uses auth.
INVENTORY_INTEGRATION_ENCRYPTION_KEY=

# Optional vehicle-image ALT/RAG descriptions. Missing key leaves confirmed
# uploads untouched and the description worker disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Cloudflare R2 vehicle image uploads (server-only except the public base URL).
R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=lume-vehicle-images
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
