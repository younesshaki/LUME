{
  "installCommand": "cd ../.. && npm install --legacy-peer-deps",
  "buildCommand": "node ../../scripts/verify-deployment-env.mjs && next build",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/inventory-feed-runs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/inventory-export-runs",
      "schedule": "*/5 * * * *"
    }
  ]
}
