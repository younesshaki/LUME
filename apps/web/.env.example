# Documentation only. Do NOT copy to .env.local: launcher rejects auto-loaded
# dotenv files. Supply project-scoped variables securely through the process.
WEB_PREVIEW_SUPABASE_URL=
WEB_PREVIEW_PROJECT_REF=
WEB_PREVIEW_SUPABASE_ANON_KEY=
# Optional STAGING-ONLY key: exact verified domains and exact vehicle gallery
# metadata, only after the anonymous vehicle visibility check.
# Not needed for query/subdomain previews; never use production's service key.
WEB_PREVIEW_SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated exact hosts, no wildcards, schemes or ports. Vercel's own
# exact VERCEL_URL is automatically accepted for VERCEL_ENV=preview only.
WEB_PREVIEW_HOSTS=
# Optional approved staging tenant DNS root; not the live production root.
WEB_PREVIEW_ROOT_DOMAIN=
WEB_PREVIEW_DEFAULT_TENANT=
# Exact custom host -> tenant slug allowlist. Each mapping is also checked
# against tenant_domains verified=true AND verification_status=verified.
WEB_PREVIEW_CUSTOM_HOSTS={}
# Public media origin for staging-owned records. Never inherit generic R2_* vars.
WEB_PREVIEW_R2_PUBLIC_BASE_URL=
# Optional exact browser origins for public read APIs; same-origin is automatic.
WEB_PREVIEW_ALLOWED_ORIGINS=
# Optional existing STAGING Vite /contact URL. Links only; no lead writes here.
WEB_PREVIEW_CONTACT_URL=
